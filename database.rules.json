{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["st"],
      "$room": {
        ".write": "auth != null"
      }
    }
  }
}
